# No environment variables are required to run CareConnect today —
# every data source is local seed data.
#
# These are the ones the documented integrations will need. Anything the
# browser must read has to be prefixed VITE_ and is PUBLIC once built:
# never put a secret key here.

# VITE_API_BASE_URL=https://api.careconnect.example
# VITE_MAPS_API_KEY=
# VITE_PAYMENT_PUBLIC_KEY=

# Server-side only (backend service, NOT this app):
# ANTHROPIC_API_KEY=
# DATABASE_URL=
